#: includes/class-wpmft-toolbar.php:59 includes/class-wpmft-security.php:49 includes/class-wpmft-api.php:52 includes/class-wpmft-demo.php:796 includes/class-wpmft-languages.php:167 includes/class-wpmft-admin.php:293 includes/class-wpmft-admin.php:526 includes/class-wpmft-admin.php:533 includes/class-wpmft-admin.php:665
msgid "A POST request is required."
msgstr "Nepieciešams POST pieprasījums."

#: includes/class-wpmft-admin.php:348
msgid "A batch of family photographs has been protected. Continue until no photographs remain."
msgstr "Dzimtas fotogrāfiju grupa ir aizsargāta. Turpiniet, līdz vairs nav atlikušu fotogrāfiju."

#: includes/class-wpmft-demo.php:715
msgid "A bundled demo illustration could not be read."
msgstr "Neizdevās nolasīt iekļauto demonstrācijas ilustrāciju."

#: includes/class-wpmft-admin.php:940
msgid "A contact field was not saved. Use a valid email address and complete http:// or https:// links. The previous value has been retained."
msgstr "Kontaktinformācijas lauks netika saglabāts. Izmantojiet derīgu e-pasta adresi un pilnas http:// vai https:// saites. Iepriekšējā vērtība ir saglabāta."

#: includes/class-wpmft-admin.php:973
msgid "A date was not saved. Use YYYY, YYYY-MM or a valid YYYY-MM-DD. The previous value has been retained."
msgstr "Datums netika saglabāts. Izmantojiet GGGG, GGGG-MM vai derīgu GGGG-MM-DD. Iepriekšējā vērtība ir saglabāta."

#: includes/class-wpmft-admin.php:145
msgid "A link to a person."
msgstr "Saite uz personu."

#: includes/class-wpmft-admin.php:982
msgid "A parent relationship was not saved because it would make a person their own ancestor."
msgstr "Vecāka saite netika saglabāta, jo tā padarītu personu par savu priekšteci."

#: includes/class-wpmft-demo.php:1217
msgid "A persistent object cache requires support from the host. Private family responses remain uncached."
msgstr "Pastāvīgai objektu kešatmiņai nepieciešams mitināšanas pakalpojuma atbalsts. Privātā dzimtas arhīva atbildes netiek saglabātas kešatmiņā."

#: includes/class-wpmft-admin.php:480
msgid "A persistent object cache was requested but is not available. WordPress transients are being used safely until a host object cache is active."
msgstr "Ir izvēlēta pastāvīgā objektu kešatmiņa, taču tā nav pieejama. Līdz hostinga objektu kešatmiņas aktivizēšanai droši tiek izmantota WordPress pagaidu kešatmiņa."

#: includes/class-wpmft-media.php:433
msgid "A photograph could not be encrypted."
msgstr "Fotogrāfiju neizdevās šifrēt."

#: includes/class-wpmft-media.php:470
msgid "A photograph could not be protected because you do not have permission to edit it. Ask an administrator to protect it or upload your own copy."
msgstr "Fotogrāfiju nevarēja aizsargāt, jo jums nav atļaujas to rediģēt. Lūdziet administratoram to aizsargāt vai augšupielādējiet savu kopiju."

#: includes/class-wpmft-media.php:429
msgid "A photograph could not be read."
msgstr "Fotogrāfiju neizdevās nolasīt."

#: includes/class-wpmft-demo.php:657
msgid "A previous demo record was repurposed. The importer stopped without changing it; restore its demo marker or use a separate demo site."
msgstr "Iepriekšējs demonstrācijas ieraksts ir pārveidots citam nolūkam. Importēšana apturēta, to nemainot; atjaunojiet tā demonstrācijas atzīmi vai izmantojiet atsevišķu demonstrācijas vietni."

#: includes/class-wpmft-media.php:425
msgid "A source photograph is missing. Restore the matching uploads backup."
msgstr "Trūkst sākotnējās fotogrāfijas. Atjaunojiet atbilstošo uploads rezerves kopiju."

#: includes/class-wpmft-demo.php:1188 includes/class-wpmft-admin.php:417
msgid "Accent colour"
msgstr "Akcenta krāsa"

#: includes/class-wpmft-media.php:285 includes/class-wpmft-demo.php:316 includes/class-wpmft-demo.php:437 includes/class-wpmft-demo.php:797 includes/class-wpmft-demo.php:1298 includes/class-wpmft-demo.php:1359 includes/class-wpmft-demo.php:1398 includes/class-wpmft-admin.php:534 includes/class-wpmft-admin.php:666 includes/class-wpmft-admin.php:837
msgid "Access denied."
msgstr "Piekļuve liegta."

#: includes/class-wpmft-languages.php:205
msgid "Add a language"
msgstr "Pievienot valodu"

#: includes/class-wpmft-admin.php:362
msgid "Add a person"
msgstr "Pievienot personu"

#: includes/class-wpmft-demo.php:854
msgid "Add eight fictional cinema characters, original gallery illustrations and two English pages. The importer adds marked sample content and preserves existing records, pages and settings. Repeating it keeps edits to existing demo items."
msgstr "Pievienojiet astoņus izdomātus kino tēlus, oriģinālas galerijas ilustrācijas un divas lapas angļu valodā. Importētājs pievieno marķētu parauga saturu un saglabā esošos ierakstus, lapas un iestatījumus. Atkārtota importēšana saglabā esošo demonstrācijas vienumu labojumus."

#: includes/class-wpmft-demo.php:913
msgid "Add fictional demo people, gallery illustrations and English pages? Existing content will be kept. Importing does not enable shared demo access."
msgstr "Vai pievienot izdomātas demonstrācijas personas, galerijas ilustrācijas un lapas angļu valodā? Esošais saturs tiks saglabāts. Importēšana neieslēdz koplietojamu demonstrācijas piekļuvi."

#: includes/class-wpmft-admin.php:283
msgid "Add no more than 50 partner relationships for one person."
msgstr "Vienai personai var pievienot ne vairāk kā 50 partnerattiecību ierakstus."

#: includes/class-wpmft-demo.php:1005 includes/class-wpmft-demo.php:1060
msgid "Add page"
msgstr "Pievienot lapu"

#: includes/class-wpmft-admin.php:746
msgid "Add partner relationship"
msgstr "Pievienot partnerattiecības"

#: includes/class-wpmft-admin.php:1037
msgid "Add people as WordPress posts."
msgstr "Pievienojiet personas kā WordPress ierakstus."

#: includes/class-wpmft-demo.php:981 includes/class-wpmft-demo.php:981 includes/class-wpmft-demo.php:1005 includes/class-wpmft-demo.php:1060 includes/class-wpmft-admin.php:117 includes/class-wpmft-admin.php:118
msgid "Add person"
msgstr "Pievienot personu"

#: includes/class-wpmft-admin.php:256 includes/class-wpmft-admin.php:825
msgid "Add photographs"
msgstr "Pievienot fotogrāfijas"

#: includes/class-wpmft-admin.php:356
msgid "Add the Family Tree block or this shortcode to a page:"
msgstr "Pievienojiet lapai Dzimtas koka bloku vai šo īskodu:"

#: includes/class-wpmft-admin.php:830
msgid "Add the people, place, occasion or an approximate date for each photograph. These stories belong to this person’s gallery and do not change captions on other pages."
msgstr "Katrai fotogrāfijai norādiet cilvēkus, vietu, notikumu vai aptuvenu datumu. Šie stāsti pieder šī cilvēka galerijai un nemaina parakstus citās lapās."

#: includes/class-wpmft-languages.php:220
msgid "Admin and server messages (JSON)"
msgstr "Administrācijas un servera paziņojumi (JSON)"

#: includes/class-wpmft-admin.php:432
msgid "Administrator WhatsApp number"
msgstr "Administratora WhatsApp numurs"

#: includes/class-wpmft-admin.php:400
msgid "After initial setup, demo tools stay hidden until you turn this on and save. This switch only shows the tools; importing content and enabling shared access each require a separate confirmation."
msgstr "Pēc sākotnējās iestatīšanas demonstrācijas rīki paliek paslēpti, līdz ieslēdzat šo iespēju un saglabājat iestatījumus. Šis slēdzis tikai parāda rīkus; satura importēšanai un koplietotās piekļuves ieslēgšanai ir vajadzīgs atsevišķs apstiprinājums."

#: includes/class-wpmft-demo.php:855
msgid "All family connections and dates are invented. Character names are illustrative references; no movie stills, celebrity photographs or official character social accounts are included."
msgstr "Visas radniecības saites un datumi ir izdomāti. Tēlu vārdi izmantoti kā ilustratīvas atsauces; filmu kadri, slavenību fotogrāfijas un oficiālie tēlu sociālo tīklu konti nav iekļauti."

#: includes/class-wpmft-demo.php:980 includes/class-wpmft-demo.php:1013 includes/class-wpmft-admin.php:126
msgid "All persons"
msgstr "Visas personas"

#: includes/class-wpmft-admin.php:342
msgid "All remembered family sessions have been revoked."
msgstr "Visas atcerētās dzimtas piekļuves sesijas ir atsauktas."

#: includes/class-wpmft-admin.php:435
msgid "Allow one photograph with a contact message"
msgstr "Atļaut ziņai pievienot vienu fotogrāfiju"

#: includes/class-wpmft-admin.php:419
msgid "Allow signed-in family visitors to save a tree image and print"
msgstr "Atļaut dzimtas apmeklētājiem ar piekļuvi saglabāt koka attēlu un drukāt"

#: includes/class-wpmft-admin.php:438
msgid "Allowed photograph formats"
msgstr "Atļautie fotogrāfiju formāti"

#: includes/class-wpmft-media.php:410
msgid "An attachment has no source file."
msgstr "Pielikumam nav sākotnējā faila."

#: includes/class-wpmft-admin.php:1034
msgid "An existing WP Family Tree category is detected during setup. Keep it selected to reuse your people and relationships."
msgstr "Iestatīšanas laikā tiek noteikta esošā WP Family Tree kategorija. Saglabājiet tās izvēli, lai izmantotu esošās personas un radniecības saites."

#: block.json
msgid "An interactive oak family tree with person dialogs and optional private access."
msgstr "Interaktīvs dzimtas koks ozola veidolā ar personu dialoglogiem un iespēju aizsargāt piekļuvi."

#: includes/class-wpmft-media.php:448
msgid "An original photograph could not be removed. Check file permissions before sharing the site."
msgstr "Neizdevās noņemt sākotnējo fotogrāfiju. Pirms vietnes kopīgošanas pārbaudiet failu piekļuves atļaujas."

#: includes/class-wpmft-demo.php:645
msgid "Another demo import is running. Please try again shortly."
msgstr "Jau notiek cits demonstrācijas imports. Pēc brīža mēģiniet vēlreiz."

#: my-family-tree.php:34
msgid "Another family tree plugin is active"
msgstr "Jau ir ieslēgts cits dzimtas koka spraudnis"

#: includes/class-wpmft-demo.php:1173 includes/class-wpmft-demo.php:1186 includes/class-wpmft-admin.php:367 includes/class-wpmft-admin.php:412
msgid "Appearance"
msgstr "Izskats"

#: includes/class-wpmft-admin.php:405
msgid "At least 12 characters. Leave blank to keep the current password. The password is stored as a one-way hash."
msgstr "Vismaz 12 rakstzīmes. Atstājiet tukšu, lai saglabātu pašreizējo paroli. Parole tiek glabāta kā vienvirziena jaucējvērtība."

#: includes/class-wpmft-contact-upload.php:55
msgid "Attach one photo only."
msgstr "Pievienojiet tikai vienu fotogrāfiju."

#: includes/class-wpmft-media.php:296 includes/class-wpmft-media.php:485
#, php-format
msgid "Attachment %1$d: %2$s"
msgstr "Pielikums %1$d: %2$s"

#: includes/class-wpmft-admin.php:478
msgid "Automatic"
msgstr "Automātiski"

#: includes/class-wpmft-admin.php:484
msgid "Automatic AVIF / WebP when supported"
msgstr "Automātiski AVIF / WebP, ja serveris tos atbalsta"

#: includes/class-wpmft-demo.php:878
msgid "Automatic demo reset"
msgstr "Automātiska demonstrācijas atiestatīšana"

#: includes/class-wpmft-admin.php:479
msgid "Automatic uses the host’s persistent object cache when available. Redis or Memcached must be configured separately by your host; otherwise this plugin uses WordPress transients. No global cache flush is performed."
msgstr "Automātiskais režīms izmanto hostinga pastāvīgo objektu kešatmiņu, ja tā ir pieejama. Redis vai Memcached atsevišķi jāiestata hostinga pakalpojuma sniedzējam; citādi spraudnis izmanto WordPress pagaidu kešatmiņu. Visas vietnes kešatmiņa netiek iztīrīta."

#: includes/class-wpmft-admin.php:408
msgid "Automatically encrypt family photograph files when people are saved"
msgstr "Automātiski šifrēt dzimtas fotogrāfiju failus, saglabājot personas"

#: includes/class-wpmft-admin.php:490
msgid "Available server encoders:"
msgstr "Serverī pieejamie attēlu kodētāji:"

#: includes/class-wpmft-demo.php:1189 includes/class-wpmft-admin.php:417
msgid "Background colour"
msgstr "Fona krāsa"

#: includes/class-wpmft-admin.php:208
msgid "Biography"
msgstr "Biogrāfija"

#: includes/class-wpmft-demo.php:1045
msgid "Biography / page story"
msgstr "Biogrāfija / lapas stāsts"

#: includes/class-wpmft-demo.php:1104 includes/class-wpmft-admin.php:781
msgid "Birth / maiden name"
msgstr "Dzimtais / meitas uzvārds"

#: includes/class-wpmft-demo.php:1104 includes/class-wpmft-admin.php:781
msgid "Birthplace"
msgstr "Dzimšanas vieta"

#: includes/class-wpmft-admin.php:514
msgid "Builds on the next tree request"
msgstr "Tiks izveidota nākamajā koka pieprasījumā"

#: includes/class-wpmft-admin.php:389
msgid "By default, people open with their details form above the biography editor. Other posts and pages keep their usual editor. Existing biographies are preserved when only person details change."
msgstr "Pēc noklusējuma personas datu veidlapa atrodas virs biogrāfijas redaktora. Citi ieraksti un lapas saglabā ierasto redaktoru. Mainot tikai personas datus, esošā biogrāfija tiek saglabāta nemainīta."

#: includes/class-wpmft-toolbar.php:50
msgid "Cache cleared"
msgstr "Kešatmiņa iztīrīta"

#: includes/class-wpmft-demo.php:1215 includes/class-wpmft-admin.php:475
msgid "Cache lifetime (minutes)"
msgstr "Kešatmiņas derīguma laiks (minūtēs)"

#: includes/class-wpmft-demo.php:1214 includes/class-wpmft-admin.php:477
msgid "Cache storage"
msgstr "Kešatmiņas glabāšana"

#: includes/class-wpmft-demo.php:1213 includes/class-wpmft-admin.php:474
msgid "Cache the internal relationship index"
msgstr "Saglabāt iekšējo radniecības indeksu kešatmiņā"

#: includes/class-wpmft-admin.php:512
msgid "Cache tools"
msgstr "Kešatmiņas rīki"

#: includes/class-wpmft-demo.php:1036 includes/class-wpmft-demo.php:1055
msgid "Cancel"
msgstr "Atcelt"

#: includes/class-wpmft-admin.php:1038
msgid "Check privacy while signed out."
msgstr "Pārbaudiet privātumu bez pieteikšanās."

#: includes/class-wpmft-admin.php:264
msgid "Checking photographs waiting for optimization…"
msgstr "Pārbauda optimizācijai gaidošās fotogrāfijas…"

#: includes/class-wpmft-admin.php:1037
msgid "Choose Add a person, enter the full name as the title, then add a portrait, dates, parents, partners, contact details and photographs in the form at the top. Write the biography below. Children and siblings come from parent links."
msgstr "Izvēlieties “Pievienot personu”, virsrakstā ievadiet vārdu un uzvārdu, pēc tam augšējā veidlapā pievienojiet portretu, datumus, vecākus, partnerus, kontaktinformāciju un fotogrāfijas. Biogrāfiju rakstiet zemāk. Bērni, brāļi un māsas tiek noteikti pēc vecāku saitēm."

#: includes/class-wpmft-demo.php:1062
msgid "Choose Edit person to try personal details, contact fields, WhatsApp and photo stories in the same layout as the family editor. Use View person to see the public profile."
msgstr "Izvēlieties Rediģēt personu, lai izmēģinātu personu datu, kontaktinformācijas, WhatsApp un fotogrāfiju stāstu laukus tādā pašā izkārtojumā kā dzimtas redaktorā. Izvēlieties Skatīt personu, lai atvērtu publisko profilu."

#: includes/class-wpmft-admin.php:740
msgid "Choose Together for a current partner and rings in the tree. Shared children alone never imply a current relationship."
msgstr "Pašreizējam partnerim izvēlieties statusu Kopā; kokā būs redzami gredzeni. Kopīgi bērni paši par sevi nenozīmē pašreizējas attiecības."

#: includes/class-wpmft-admin.php:391
msgid "Choose a page"
msgstr "Izvēlieties lapu"

#: includes/class-wpmft-demo.php:1300
msgid "Choose a person or a demo page."
msgstr "Izvēlieties personu vai demonstrācijas lapu."

#: includes/class-wpmft-admin.php:284 includes/class-wpmft-admin.php:769
msgid "Choose a portrait"
msgstr "Izvēlēties portretu"

#: includes/class-wpmft-languages.php:189
msgid "Choose available interface languages, edit labels or add any number of languages. English is the fallback. Names and biographies are translated separately with optional Polylang."
msgstr "Izvēlieties pieejamās saskarnes valodas, rediģējiet tekstus vai pievienojiet neierobežotu skaitu valodu. Rezerves valoda ir angļu. Personu vārdus un dzīvesstāstus tulko atsevišķi ar izvēles spraudni Polylang."

#: includes/class-wpmft-admin.php:254
msgid "Choose family photographs"
msgstr "Izvēlieties dzimtas fotogrāfijas"

#: includes/class-wpmft-admin.php:1034
msgid "Choose your family category."
msgstr "Izvēlieties dzimtas kategoriju."

#: includes/class-wpmft-demo.php:632
msgid "Cinema family demo"
msgstr "Kino dzimtas demonstrācija"

#: includes/class-wpmft-toolbar.php:28 includes/class-wpmft-toolbar.php:48 includes/class-wpmft-admin.php:518
msgid "Clear Family Tree cache"
msgstr "Iztīrīt dzimtas koka kešatmiņu"

#: includes/class-wpmft-toolbar.php:49
msgid "Clearing cache…"
msgstr "Tīra kešatmiņu…"

#: includes/class-wpmft-admin.php:519
msgid "Clears this plugin’s index and refreshes its static asset URLs. Passwords, remembered access, anti-spam limits and protected media are retained. Host, CDN and other plugins’ caches are managed separately."
msgstr "Iztīra šī spraudņa indeksu un atjaunina skriptu un stilu failu URL. Paroles, atcerētā piekļuve, pretsurogātpasta ierobežojumi un aizsargātie multivides faili tiek saglabāti. Servera, CDN un citu spraudņu kešatmiņas tiek pārvaldītas atsevišķi."

#: includes/class-wpmft-performance.php:152
msgid "Comments are disabled for posts, pages and media."
msgstr "Komentāri ziņām, lapām un multivides failiem ir atspējoti."

#: includes/class-wpmft-admin.php:507
msgid "Compact the full-window page HTML"
msgstr "Samazināt pilna loga lapas HTML apjomu"

#: includes/class-wpmft-demo.php:1362
msgid "Confirm removal before continuing."
msgstr "Pirms turpināšanas apstipriniet noņemšanu."

#: includes/class-wpmft-demo.php:1173 includes/class-wpmft-demo.php:1205 includes/class-wpmft-admin.php:367 includes/class-wpmft-admin.php:424
msgid "Contact & hCaptcha"
msgstr "Kontakti un hCaptcha"

#: includes/class-wpmft-demo.php:1113 includes/class-wpmft-admin.php:791
msgid "Contact details"
msgstr "Kontaktinformācija"

#: includes/class-wpmft-demo.php:1206
msgid "Contact messages"
msgstr "Kontaktformas ziņas"

#: includes/class-wpmft-admin.php:429
msgid "Contact messages use WordPress mail delivery. The form does not save message contents to the family tree database. Your mail provider may retain delivered messages."
msgstr "Saziņas ziņojumi izmanto WordPress pasta sūtīšanu. Forma nesaglabā ziņojumu saturu dzimtas koka datubāzē. Jūsu pasta pakalpojuma sniedzējs var saglabāt piegādātos ziņojumus."

#: includes/class-wpmft-admin.php:434
msgid "Contact photo uploads"
msgstr "Kontaktformas fotogrāfijas"

#: includes/class-wpmft-security.php:161 includes/class-wpmft-security.php:165 includes/class-wpmft-security.php:169
msgid "Content not found."
msgstr "Saturs nav atrasts."

#: includes/class-wpmft-languages.php:206
msgid "Copy the labels you want to change into a language’s Front-end labels JSON field. Keep placeholders unchanged, for example {name}, {count} and {days}."
msgstr "Iekopējiet maināmos tekstus attiecīgās valodas laukā “Publiskās saskarnes teksti (JSON)”. Atstājiet vietturus nemainītus, piemēram, {name}, {count} un {days}."

#: includes/class-wpmft-admin.php:270
msgid "Could not calculate photograph counts. You can still start preparation or reload this page."
msgstr "Neizdevās aprēķināt fotogrāfiju skaitu. Varat sākt sagatavošanu vai pārlādēt šo lapu."

#: includes/class-wpmft-admin.php:259
msgid "Could not load all photographs. Your gallery has not changed. Please try again."
msgstr "Neizdevās ielādēt visas fotogrāfijas. Jūsu galerija nav mainīta. Lūdzu, mēģiniet vēlreiz."

#: includes/class-wpmft-admin.php:458
msgid "Create a tree page"
msgstr "Izveidot koka lapu"

#: includes/class-wpmft-admin.php:1035
msgid "Create or edit the tree page."
msgstr "Izveidojiet vai rediģējiet koka lapu."

#: includes/class-wpmft-demo.php:1104 includes/class-wpmft-admin.php:781
msgid "Date of birth"
msgstr "Dzimšanas datums"

#: includes/class-wpmft-demo.php:1104 includes/class-wpmft-admin.php:781
msgid "Date of death (leave blank if living)"
msgstr "Miršanas datums (dzīvai personai atstājiet tukšu)"

#: includes/class-wpmft-demo.php:1106 includes/class-wpmft-admin.php:785
msgid "Dates accept YYYY, YYYY-MM or YYYY-MM-DD. Older date text is retained unless you change it."
msgstr "Datumiem izmantojiet GGGG, GGGG-MM vai GGGG-MM-DD. Iepriekšējais datuma teksts tiek saglabāts, ja to nemaināt."

#: my-family-tree.php:33
msgid "Deactivate the older WP My Family Tree plugin or any duplicate copy before activating My Family Tree. Your family posts, photographs and saved settings will be retained."
msgstr "Izslēdziet iepriekšējo WP My Family Tree spraudni vai tā dublikātu, pirms ieslēdzat My Family Tree. Jūsu dzimtas ieraksti, fotoattēli un saglabātie iestatījumi tiks saglabāti."

#: includes/class-wpmft-admin.php:329
msgid "Deactivate the original WP Family Tree plugin. Its older public routes can bypass the privacy settings of this replacement. Your posts and photographs are retained."
msgstr "Deaktivizējiet sākotnējo WP Family Tree spraudni. Tā vecākie publiskie piekļuves ceļi var apiet šī aizstājēja privātuma iestatījumus. Jūsu ieraksti un fotogrāfijas tiks saglabāti."

#: includes/class-wpmft-demo.php:1194 includes/class-wpmft-languages.php:199 includes/class-wpmft-admin.php:395
msgid "Default interface language"
msgstr "Noklusējuma saskarnes valoda"

#: includes/class-wpmft-admin.php:367 includes/class-wpmft-admin.php:451
msgid "Demo"
msgstr "Demonstrācija"

