msgstr "Fotogrāfijas noņemšana šeit to noņem tikai no šīs galerijas. Sākotnējais multivides fails netiek dzēsts."

#: includes/class-wpmft-admin.php:157
msgid "Require a family password"
msgstr "Pieprasīt dzimtas paroli"

#: includes/class-wpmft-admin.php:570
msgid "Restore a matching UpdraftPlus set on staging first. Preserve every filename exactly, including its date, site name, 12-character identifier and -db.gz / -plugins.zip / -themes.zip / -uploads.zip suffix. A standalone plugin ZIP is installed using Plugins → Add New → Upload Plugin, not the Updraft restore screen."
msgstr "Vispirms atjaunojiet vienu pilnu UpdraftPlus kopu testa vietnē. Precīzi saglabājiet katru faila nosaukumu, tostarp datumu, vietnes nosaukumu, 12 rakstzīmju identifikatoru un -db.gz / -plugins.zip / -themes.zip / -uploads.zip galotni. Atsevišķu spraudņa ZIP uzstāda sadaļā Spraudņi → Pievienot jaunu → Augšupielādēt spraudni, nevis Updraft atjaunošanas logā."

#: includes/class-wpmft-admin.php:569
msgid "Restore backups safely"
msgstr "Droši atjaunojiet rezerves kopijas"

#: includes/class-wpmft-admin.php:193
msgid "Revoke all remembered access"
msgstr "Atsaukt visu atcerēto piekļuvi"

#: includes/class-wpmft-admin.php:189
msgid "Save settings"
msgstr "Saglabāt iestatījumus"

