msgstr "Mūsu dzimtas koks"

#: includes/class-wpmft-admin.php:461
msgid "Partner / co-parent"
msgstr "Partneris / kopīgā bērna vecāks"

#: includes/class-wpmft-admin.php:492
msgid "Partner relationships"
msgstr "Partnerattiecības"

#: includes/class-wpmft-admin.php:756
msgid "Person editor"
msgstr "Personu redaktors"

